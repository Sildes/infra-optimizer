# Copier ce fichier en .env et remplir la clé. Le .env est ignoré par git.
# Sans clé, le pipeline tourne en mode déterministe (défaut) — aucun .env requis.

# N'importe quel fournisseur OpenAI-compatible :
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6

# Exemples d'autres fournisseurs (décommenter) :
# OpenAI   : LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
# Mistral  : LLM_BASE_URL=https://api.mistral.ai/v1          LLM_MODEL=mistral-large-latest
# Ollama   : LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3
